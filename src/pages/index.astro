---
import Layout from '../layouts/Layout.astro';
import Rail from '../components/Rail.astro';
import LiquidMark from '../components/LiquidMark.astro';
import Work from '../components/Work.astro';
import Timeline from '../components/Timeline.astro';
import Clocks from '../components/Clocks.astro';
import SocialIcon from '../components/SocialIcon.astro';
import { profile, intro, availability } from '../data/site';
---

<Layout>
  <a class="skip" href="#about">Skip to content</a>

  <div class="shell">
    <Rail />

    <main class="page">
      <section class="hero" id="top">
        <div class="wrap">
          <div class="hero__lockup">
            <LiquidMark>
              <button class="hero__dot" slot="dot" type="button" data-theme-toggle aria-pressed="false">
                <span class="sr-only" data-theme-label>Light</span>
              </button>
            </LiquidMark>

            <!-- No trailing dot: the mark above already carries the `.` -->
            <h1 class="hero__name">Jacob Chau</h1>
          </div>

          <a class="hero__cue" href="#about">
            <span class="hero__cueLine" aria-hidden="true"></span>
            <span class="label">Scroll</span>
          </a>
        </div>
      </section>

      <section class="sec" id="about">
        <div class="wrap">
          <header class="sec__head reveal">
            <span class="sec__idx label">01</span>
            <h2 class="sec__title">About<span class="dot">.</span></h2>
          </header>

          <div class="about reveal">
            {
              intro.map((para, i) => (
                <p
                  class:list={[
                    'about__p',
                    { 'about__p--lead': i === 0 },
                    { 'about__p--statement': i > 0 && i === intro.length - 1 },
                  ]}
                >
                  {para}
                </p>
              ))
            }
            <p class="about__avail">{availability}</p>
          </div>
        </div>
      </section>

      <section class="sec" id="work">
        <div class="wrap">
          <header class="sec__head reveal">
            <span class="sec__idx label">02</span>
            <h2 class="sec__title">Work<span class="dot">.</span></h2>
          </header>

          <Work />
        </div>
      </section>

      <section class="sec" id="path">
        <div class="wrap">
          <header class="sec__head reveal">
            <span class="sec__idx label">03</span>
            <h2 class="sec__title">Path<span class="dot">.</span></h2>
          </header>

          <Timeline />
        </div>
      </section>

      <section class="sec sec--last" id="contact">
        <div class="wrap">
          <header class="sec__head reveal">
            <span class="sec__idx label">04</span>
            <h2 class="sec__title">Contact<span class="dot">.</span></h2>
          </header>

          <div class="contact reveal">
            <a class="contact__email" href={`mailto:${profile.email}`}>
              <span class="uline">{profile.email}</span>
              <span class="contact__arrow" aria-hidden="true">→</span>
            </a>

            <div class="contact__grid">
              <div class="contact__block">
                <h3 class="label">Elsewhere</h3>
                <ul class="contact__socials contact__body">
                  {
                    profile.socials.map((s) => (
                      <li>
                        <a
                          href={s.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="contact__social"
                          aria-label={s.name}
                        >
                          <SocialIcon name={s.icon} />
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>

              <div class="contact__block">
                <h3 class="label">Local time</h3>
                <!-- Wrapper rather than a margin on <Clocks />: that component's
                     scoped `margin: 0` ties on specificity and wins on order. -->
                <div class="contact__body">
                  <Clocks />
                </div>
              </div>
            </div>
          </div>

          <footer class="foot">
            <span class="label">© {new Date().getFullYear()} {profile.name}</span>
          </footer>
        </div>
      </section>
    </main>
  </div>
</Layout>

<style>
  .skip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background-color: var(--color-accent);
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    transform: translateY(-120%);
    transition: transform 0.2s ease;
  }

  .skip:focus-visible {
    transform: translateY(0);
  }

  /* Rail pinned to the left gutter, content taking the rest of the width. */
  .shell {
    padding-inline: var(--gutter);
    display: grid;
    grid-template-columns: var(--rail-w) minmax(0, 1fr);
    column-gap: var(--rail-gap);
  }

  /* Left-aligned in its cell. Only bites past ~1750px, where a full-bleed column
     would stretch the section rules to absurd lengths. */
  .page {
    max-width: 80rem;
  }

  .wrap {
    width: 100%;
  }

  /* ---- hero ---- */

  .hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    padding-block: 6rem;
  }

  .hero__lockup {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* Deliberately small: the mask carries ~6% transparent padding along its
       bottom edge, so the visual gap is larger than this. */
    gap: 0.6rem;
    /* Pulls the glyph's left side bearing onto the text column's edge. */
    margin-left: -0.35rem;
  }

  /* The wordmark's rose dot, which doubles as the theme toggle. A real button,
     positioned on the glyph baseline by LiquidMark. */
  .hero__dot {
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background-color: var(--color-accent);
    cursor: pointer;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.28s ease;
  }

  .hero__dot:hover,
  .hero__dot:focus-visible {
    transform: scale(1.22);
    box-shadow: 0 0 18px var(--color-accent);
  }

  .hero__name {
    font-size: clamp(2rem, 4.6vw, 3.25rem);
    line-height: 1;
  }

  .hero__cue {
    position: absolute;
    bottom: 2.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-muted);
    transition: color 0.25s ease;
  }

  .hero__cue:hover {
    color: var(--color-text);
  }

  .hero__cueLine {
    display: block;
    width: 2.5rem;
    height: 1px;
    background-color: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__cueLine {
      transform-origin: left;
      animation: cue 2.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
    }
  }

  @keyframes cue {
    0%,
    100% {
      transform: scaleX(0.45);
      opacity: 0.5;
    }
    50% {
      transform: scaleX(1);
      opacity: 1;
    }
  }

  /* ---- sections ---- */

  .sec {
    padding-block: clamp(5rem, 12vh, 9rem);
  }

  .sec--last {
    padding-bottom: clamp(3rem, 8vh, 5rem);
  }

  .sec__head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-hairline);
  }

  .sec__idx {
    flex: none;
  }

  .sec__title {
    font-size: clamp(1.75rem, 4.5vw, 2.5rem);
  }

  /* ---- about ---- */

  .about {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: var(--measure);
  }

  .about__p {
    font-size: clamp(1rem, 1.8vw, 1.125rem);
    color: var(--color-text-secondary);
  }

  .about__p--lead {
    color: var(--color-text);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
  }

  /* The closing line carries the section, so it lands as a statement rather than
     trailing off as another paragraph. */
  .about__p--statement {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3.4vw, 2.125rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-text);
    margin-top: 0.75rem;
  }

  .about__avail {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-accent);
  }

  /* ---- contact ---- */

  .contact {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    width: fit-content;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    font-size: clamp(1.125rem, 3.2vw, 1.75rem);
    color: var(--color-text);
    transition: color 0.25s ease;
  }

  .contact__email:hover {
    color: var(--color-accent);
  }

  .contact__arrow {
    display: inline-block;
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .contact__email:hover .contact__arrow {
    transform: translateX(0.4rem);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2.5rem;
  }

  .contact__socials {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .contact__social {
    display: block;
    color: var(--color-muted);
    transition: color 0.25s ease, transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .contact__social:hover,
  .contact__social:focus-visible {
    color: var(--color-text);
    transform: translateY(-2px);
  }

  /* Breathing room under each column's label. */
  .contact__body {
    margin-top: 1.5rem;
  }

  .foot {
    margin-top: 4.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-hairline);
  }

  /* ---- narrow ---- */

  @media (max-width: 60rem) {
    /* The rail is hidden here, so collapse its column or it leaves an 11rem
       hole down the left. */
    .shell {
      grid-template-columns: minmax(0, 1fr);
      column-gap: 0;
    }

    .hero {
      padding-block: 4rem;
    }
  }
</style>

<script>
  // The wordmark's rose dot is the theme control; any [data-theme-toggle] drives it.
  const labels = document.querySelectorAll<HTMLElement>('[data-theme-label]');
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');

  function syncTheme() {
    const dark = document.documentElement.getAttribute('data-theme') !== 'light';
    labels.forEach((el) => (el.textContent = dark ? 'Light' : 'Dark'));
    toggles.forEach((el) => {
      el.setAttribute('aria-pressed', String(!dark));
      el.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }

  toggles.forEach((btn) =>
    btn.addEventListener('click', () => {
      const next =
        document.documentElement.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* private mode: the choice just won't persist */
      }
      syncTheme();
    })
  );

  syncTheme();
</script>
